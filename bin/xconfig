X955F|0X9580|0X9581|0X9583|0X9586|0X9587|0X9588|0X9589|0X958A|0X958B|0X958C|0X958D|0X958E|0X958F|0X9590|0X9591|0X9593|0X9595|0X9596|0X9597|0X9598|0X9599|0X959B|0X95C0|0X95C2|0X95C4|0X95C5|0X95C6|0X95C7|0X95C9|0X95CC|0X95CD|0X95CE|0X95CF|0X9610|0X9611|0X9612|0X9613|0X9614|0X9615|0X9616|0X9640|0X9641|0X9642|0X9643|0X9644|0X9645|0X9647|0X9648|0X9649|0X964A|0X964B|0X964C|0X964E|0X964F|0X9710|0X9711|0X9712|0X9713|0X9714|0X9715|0X9802|0X9803|0X9804|0X9805|0X9806|0X9807|0X9808|0X9809|0X980A|0X9830|0X9831|0X9832|0X9833|0X9834|0X9835|0X9836|0X9837|0X9838|0X9839|0X983A|0X983B|0X983C|0X983D|0X983E|0X983F|0X9850|0X9851|0X9852|0X9853|0X9854|0X9855|0X9856|0X9857|0X9858|0X9859|0X985A|0X985B|0X985C|0X985D|0X985E|0X985F|0X9874|0X98E4|0X9900|0X9901|0X9903|0X9904|0X9905|0X9906|0X9907|0X9908|0X9909|0X990A|0X990B|0X990C|0X990D|0X990E|0X990F|0X9910|0X9913|0X9917|0X9918|0X9919|0X9990|0X9991|0X9992|0X9993|0X9994|0X9995|0X9996|0X9997|0X9998|0X9999|0X999A|0X999B|0X999C|0X999D|0X99A0|0X99A2|0X99A4"

ndeveldrivers="GeForce RTX 50(60|70|80|90)( Ti)?( Laptop GPU)?"

# Check to see if NVidia graphics is primary
if pciconf -lv | grep -B 3 VGA | grep -q "NVIDIA"; then
  if pciconf -lv | grep -B 3 VGA | grep -q -E "($ndeveldrivers)"; then
    NVDRIVER="devel"
  fi
  if pciconf -lv | grep -B 3 VGA | grep -q -E "($ndrivers)" && [ -z "${NVDRIVER}" ]; then
    NVDRIVER="latest"
  fi
  if pciconf -lv | grep -B 3 VGA | grep -q -E "($n470drivers)" && [ -z "${NVDRIVER}" ] ; then
    NVDRIVER="470"
  fi
  if pciconf -lv | grep -B 3 VGA | grep -q -E "($n390drivers)" && [ -z "${NVDRIVER}" ] ; then
    NVDRIVER="390"
  fi

  if pciconf -lv | grep -B 3 VGA | grep -q -E "($n340drivers)" && [ -z "${NVDRIVER}" ]; then
    NVDRIVER="340"
  fi
  if pciconf -lv | grep -B 3 VGA | grep -q -E "($n304drivers)" && [ -z "${NVDRIVER}" ]; then
    NVDRIVER="304"
  fi
fi

setup_virtualbox()
{
  echo "Setting up virtualbox settings.. Please wait.."
  sysrc vboxguest_enable="YES" || return 1
  service vboxguest start || return 1
  sysrc vboxservice_enable="YES" || return 1
  service vboxservice start || return 1
}

backup_xorg_conf()
{
  [ -f "${XORG_CONF}" ] || return 0
  mkdir -p "${XORG_BACKUP_DIR}" || return 1
  backup="${XORG_BACKUP_DIR}/xorg.conf.$(date '+%Y%m%d_%H%M%S')"
  cp "${XORG_CONF}" "${backup}"
}

install_xorg_conf()
{
  backup_xorg_conf || return 1
  cp "$1" "${XORG_CONF}"
}

configure_nvidia_xorg()
{
  X -configure || return 1
  sed -i "" 's/"nv"/"nvidia"/g' /root/xorg.conf.new || return 1
  sed -i "" 's/scfb/nvidia/g' /root/xorg.conf.new || return 1
  sed -i "" 's/vesa/nvidia/g' /root/xorg.conf.new || return 1
  sed -i "" 's/modesetting/nvidia/g' /root/xorg.conf.new || return 1
  printf '
Section "ServerFlags"
    Option "IgnoreABI" "1"
EndSection
' >> /root/xorg.conf.new || return 1
  install_xorg_conf /root/xorg.conf.new
}

install_and_setup_nvidia()
{
  echo "Installing and setting up (NVIDIA).. Please wait.."
  if [ "${NVDRIVER}" = "devel" ] ; then
    mport install nvidia-driver-devel nvidia-drm-510-kmod-devel || return 1
    sysrc -f /boot/loader.conf hw.nvidiadrm.modeset=1 || return 1
    sysrc -f /etc/rc.conf kld_list+="nvidia-modeset nvidia-drm" || return 1
    kldload nvidia-modeset || return 1
    echo "NVIDIA DRM support will be enabled after reboot."
  elif [ "${NVDRIVER}" = "latest" ] ; then
    mport install nvidia-driver || return 1
    kldload nvidia-modeset || return 1
    sysrc -f /etc/rc.conf kld_list+="nvidia-modeset" || return 1
  elif [ "${NVDRIVER}" = "470" ] ; then
    mport install nvidia-driver-470 || return 1
    kldload nvidia-modeset || return 1
    sysrc -f /etc/rc.conf kld_list+="nvidia-modeset" || return 1
  elif [ "${NVDRIVER}" = "390" ] ; then
    mport install nvidia-driver-390 || return 1
    kldload nvidia-modeset || return 1
    sysrc -f /etc/rc.conf kld_list+="nvidia-modeset" || return 1
  elif [ "${NVDRIVER}" = "340" ] ; then
    mport install nvidia-driver-340 || return 1
    kldload nvidia || return 1
    sysrc -f /etc/rc.conf kld_list+="nvidia" || return 1
  elif [ "${NVDRIVER}" = "304" ] ; then
    mport install nvidia-driver-304 || return 1
    kldload nvidia || return 1
    sysrc -f /etc/rc.conf kld_list+="nvidia" || return 1
  else
    echo "No supported NVIDIA driver was detected." >&2
    return 1
  fi
  configure_nvidia_xorg
}

setup_nvidia()
{
  echo "Setting up (NVIDIA).. Please wait.."
  sysrc -f /etc/rc.conf kld_list+="nvidia-modeset" || return 1
  kldload nvidia-modeset || return 1
  configure_nvidia_xorg
}

ensure_intel_drm()
{
  if [ "$(sysctl -n kern.osreldate)" -ge 402000 ]; then
    if ! mport -U info -e drm-515-kmod >/dev/null 2>&1; then
      mport install drm-515-kmod || return 1
    fi
    if pciconf -lv | grep -B 4 VGA | grep -qi 'Alder Lake'; then
      if ! mport -U info -e gpu-firmware-intel-kmod-alderlake >/dev/null 2>&1; then
        mport install gpu-firmware-intel-kmod-alderlake || return 1
      fi
    fi
  fi
}

setup_intel_drm()
{
  echo "Setting up (Intel DRM).. Please wait.."
  ensure_intel_drm || return 1
  kldload /boot/modules/i915kms.ko || return 1
  sysrc -f /etc/rc.conf kld_list+="/boot/modules/i915kms.ko" || return 1
  sysrc -f /etc/rc.conf kld_list-="/boot/modules/amdgpu.ko" || return 1
  sysrc -f /etc/rc.conf kld_list-="/boot/modules/radeonkms.ko" || return 1
}

start_legacy_intel()
{
  echo "Setting up (Legacy Intel).. Please wait.."
  ensure_intel_drm || return 1
  kldload /boot/modules/i915kms.ko || return 1
  sysrc -f /etc/rc.conf kld_list-="/boot/modules/i915kms.ko" || return 1
  sysrc -f /etc/rc.conf kld_list-="/boot/modules/amdgpu.ko" || return 1
  sysrc -f /etc/rc.conf kld_list-="/boot/modules/radeonkms.ko" || return 1
}

setup_amdgpu_radeonkms_drm()
{
  if pciconf -lv | grep -B 4 VGA | grep -qi -E "($radeon_devices)"; then
    echo "Setting up (radeonkms).. Please wait.."
    kldload /boot/modules/radeonkms.ko || return 1
    sysrc -f /etc/rc.conf kld_list+="/boot/modules/radeonkms.ko" || return 1
    sysrc -f /etc/rc.conf kld_list-="/boot/modules/amdgpu.ko" || return 1
  else
    echo "Setting up (amdgpu).. Please wait.."
    kldload /boot/modules/amdgpu.ko || return 1
    sysrc -f /etc/rc.conf kld_list+="/boot/modules/amdgpu.ko" || return 1
    sysrc -f /etc/rc.conf kld_list-="/boot/modules/radeonkms.ko" || return 1
  fi
  sysrc -f /etc/rc.conf kld_list-="/boot/modules/i915kms.ko" || return 1
}

setup_radeonkms_drm()
{
  echo "Setting up (radeonkms).. Please wait.."
  kldload /boot/modules/radeonkms.ko || return 1
  sysrc -f /etc/rc.conf kld_list+="/boot/modules/radeonkms.ko" || return 1
  sysrc -f /etc/rc.conf kld_list-="/boot/modules/i915kms.ko" || return 1
  sysrc -f /etc/rc.conf kld_list-="/boot/modules/amdgpu.ko" || return 1
}

setup_amdgpu_drm()
{
  echo "Setting up (amdgpu).. Please wait.."
  kldload /boot/modules/amdgpu.ko || return 1
  sysrc -f /etc/rc.conf kld_list+="/boot/modules/amdgpu.ko" || return 1
  sysrc -f /etc/rc.conf kld_list-="/boot/modules/radeonkms.ko" || return 1
  sysrc -f /etc/rc.conf kld_list-="/boot/modules/i915kms.ko" || return 1
}

start_radeonkms()
{
  echo "Setting up (radeonkms).. Please wait.."
  kldunload /boot/modules/amdgpu.ko
  kldload /boot/modules/radeonkms.ko || return 1
  kldunload /boot/modules/i915kms.ko
  sysrc -f /etc/rc.conf kld_list-="/boot/modules/amdgpu.ko" || return 1
  sysrc -f /etc/rc.conf kld_list+="/boot/modules/radeonkms.ko" || return 1
  sysrc -f /etc/rc.conf kld_list-="/boot/modules/i915kms.ko" || return 1
  X -configure || return 1
  sed -i "" 's/amdgpu/radeon/g' /root/xorg.conf.new || return 1
  sed -i "" 's/scfb/radeon/g' /root/xorg.conf.new || return 1
  sed -i "" 's/vesa/radeon/g' /root/xorg.conf.new || return 1
  install_xorg_conf /root/xorg.conf.new
}

start_amdgpu()
{
  echo "Setting up (amdgpu).. Please wait.."
  kldload /boot/modules/amdgpu.ko || return 1
  kldunload /boot/modules/radeonkms.ko
  kldunload /boot/modules/i915kms.ko
  sysrc -f /etc/rc.conf kld_list+="/boot/modules/amdgpu.ko" || return 1
  sysrc -f /etc/rc.conf kld_list-="/boot/modules/radeonkms.ko" || return 1
  sysrc -f /etc/rc.conf kld_list-="/boot/modules/i915kms.ko" || return 1
  X -configure || return 1
  sed -i "" 's/radeon/amdgpu/g' /root/xorg.conf.new || return 1
  sed -i "" 's/scfb/amdgpu/g' /root/xorg.conf.new || return 1
  sed -i "" 's/vesa/amdgpu/g' /root/xorg.conf.new || return 1
  install_xorg_conf /root/xorg.conf.new
}

start_shell()
{
  clear
  echo "# MidnightBSD Emergency Shell
#
# Please type 'exit' to return to the menu
#############################################################"
  /bin/mksh
}

manual_setup()
{
  dialog --title "X Configuration Menu" \
  --menu "Please select from the following options:" 20 55 15 \
  drm_intel "Start Desktop with Intel DRM driver" \
  amdgpu "Start Desktop with AMD GPU driver" \
  radeonkms "Start Desktop with Radeon KMS driver" \
  nvidia "Start Desktop with Nvidia ${NVERSION} driver" \
  vesa "Start Desktop with VESA driver" \
  scfb "Start Desktop with SCFB driver" \
  virtualbox "Start Desktop with VirtualBox driver" \
  shell "Drop to emergency shell" \
  reboot "Reboot the system" \
  exit "Exit X Configuration" 2>"${ANSWER_FILE}"

  ANS="$(cat "${ANSWER_FILE}")"
  case $ANS in
    nvidia) install_and_setup_nvidia ;;
    drm_intel) setup_intel_drm ;;
    amdgpu) start_amdgpu ;;
    radeonkms) start_radeonkms ;;
    vesa) echo "Setting up (VESA).. Please wait.."
      install_xorg_conf /usr/local/etc/X11/cardDetect/XF86Config.vesa
      ;;
    scfb) echo "Setting up (SCFB).. Please wait.."
      install_xorg_conf /usr/local/etc/X11/cardDetect/XF86Config.scfb
      ;;
    virtualbox) setup_virtualbox ;;
    shell) start_shell ;;
    reboot) sudo reboot -q ;;
    exit) exit 0 ;;
    *) ;;
  esac
}

fail_safe()
{
  dialog --title "Failed to auto start X" \
  --menu "Please select from the following options:" 20 55 15 \
  intel "Start Desktop with Legacy Intel driver" \
  amdgpu "Start Desktop with DRM AMDGPU driver" \
  radeonkmsdrm "Start Desktop with DRM Radeon KMS driver" \
  vesa "Start Desktop with VESA driver" \
  scfb "Start Desktop with SCFB driver" \
  shell "Drop to emergency shell" \
  reboot "Reboot the system" \
  exit "Exit X Configuration" 2>"${ANSWER_FILE}"

  ANS="$(cat "${ANSWER_FILE}")"
  case $ANS in
    intel) start_legacy_intel ;;
    amdgpu) setup_amdgpu_drm ;;
    radeonkmsdrm) setup_radeonkms_drm ;;
    vesa) echo "Setting up (VESA).. Please wait.."
      install_xorg_conf /usr/local/etc/X11/cardDetect/XF86Config.vesa
      ;;
    scfb) echo "Setting up (SCFB).. Please wait.."
      install_xorg_conf /usr/local/etc/X11/cardDetect/XF86Config.scfb
      ;;
    virtualbox) setup_virtualbox ;;
    shell) start_shell ;;
    reboot) sudo reboot -q ;;
    exit) exit 0 ;;
    *) ;;
  esac
}

auto_configure_x()
{
  if [ -z "${NVDRIVER}" ] ; then
    # First check if we are running as a VirtualBox guest
    if pciconf -lv | grep -q "VirtualBox" ; then
      setup_virtualbox
    else
      # Uninstall virtualbox-ose-additions since we are not running on virtualbox
      mport delete virtualbox-ose-additions
      # Check to see if we are running as VMware guest
      pciconf -lv | grep -q "vmware"
      if pciconf -lv | grep -q "vmware" ; then
        install_xorg_conf /usr/local/etc/X11/cardDetect/XF86Config.vmware
      else
        pciconf -lv | grep -B 4 VGA | grep -q Intel
        if pciconf -lv | grep -B 4 VGA | grep -q Intel ; then
          setup_intel_drm
        else
          pciconf -lv | grep -B 4 VGA | grep -q 'AMD/ATI'
          if pciconf -lv | grep -B 4 VGA | grep -q 'AMD/ATI' ; then
            setup_amdgpu_radeonkms_drm
          else
            fail_safe
          fi
        fi
      fi
    fi
  else
    # Uninstall virtualbox-ose-additions since we are not running on virtualbox
    mport delete virtualbox-ose-additions
    # Prefer the integrated Intel GPU on Optimus hardware.
    if pciconf -lv | grep -B 4 VGA | grep -q Intel ; then
      setup_intel_drm
    else
      install_and_setup_nvidia
    fi
  fi
}

if [ "${TOSTART}" = 'setup' ] ; then
  manual_setup
elif [ "${TOSTART}" = 'auto' ]; then
  auto_configure_x
else
  manual_setup
fi
